        <div class="list">
            <div class="img">
                <img src="/property/<%= rs._id %>/image" alt="<%= rs.pname %>" loading="lazy" decoding="async">
            </div>
            <div class="cont">
                <p class="desc"><%= rs.description %></p>
                <% if (showIcons) { %>
                <p class="icons">
                    <span class="ic"><i class="fa-solid fa-bed"></i><%= rs.numberOfRooms %></span>
                    <span class="ic"><i class="fa-solid fa-toilet"></i><%= rs.numberOfToilets %></span>
                    <span class="ic"><i class="fa-solid fa-bath"></i><%= rs.numberOfBathrooms %></span>
                </p>
                <% } %>
                <p class="price"><%= rs.price %></p>
                <p class="location"><%= rs.location %></p>
                <p class="whatsapp"><a href="https://wa.me/<%= encodeURIComponent(rs.whatsapp) %>"><i class="fa-brands fa-whatsapp fa-2x"></i></a></p>
            </div>
        </div>
