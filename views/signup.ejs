
<%- include('header.ejs') %>

        <section class="grid-box">

            <section class="grid-box1"></section>
            <section class="grid-box2">
                <h3>Signup Form</h3>
                <p>Please fill the form fields below</p>


                <% if(typeof(message) !== "undefined"){ %>
                    <h5 style="color:blue"><%= message %></h5>
                <% } %>

                <% if(typeof(error_msg) !== "undefined") { %>
                    <h5 style="color:red"><%= error_msg %></h5>
                <% } %>

                <% if(typeof(errors) !== 'undefined'){ %>
                        <% errors.forEach((er) => { %>
                                <h5 style="color:red"><%= er.msg %></h5>
                       <% }) %>
                <% } %>

                <form action="/signup" method="post" enctype="multipart/form-data">
                    <input type="text" name="fn" placeholder="Your Firstname">
                    <input type="text" name="ln" placeholder="Your Lastname">
                    <input type="email" name="email" placeholder="Your Email">
                    <input type="text" name="whatsapp" placeholder="Whatsapp Phone Number">
                    Agent <input type="radio" name="userCategory" value="Agent">
                    Landlord <input type="radio" name="userCategory" value="Landlord">
                    Developer <input type="radio"name="userCategory"value="Developer">
                    <input type="text" name="username" placeholder="Preffered Username">
                    <input type="password" name="password" placeholder="Your Password">
                    <input type="password" name="password1" placeholder="Confirm Password">
                    <input type="file" name="image">
                    <input type="submit" value="Register">
                </form>
            </section>

        </section>

<%- include('footer.ejs') %>